# Copy to .env and fill in. Never commit .env.

POSTGRES_USER=shopsense
POSTGRES_PASSWORD=change-me-postgres

# Bootstrap admin account (created on first start)
ADMIN_EMAIL=admin@shopsense.local
ADMIN_PASSWORD=change-me-Admin123!

# 32+ random characters, e.g. `openssl rand -base64 48`
JWT_SIGNING_KEY=

# Optional: enables the Claude-powered assistant and copywriter.
# Leave empty to run the deterministic offline assistant.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Expose interactive API docs at http://localhost:5080/scalar
API_ENABLE_DOCS=true
