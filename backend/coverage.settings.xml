<?xml version="1.0" encoding="utf-8"?>
<!-- Microsoft.Testing.Extensions.CodeCoverage settings: measure first-party code only. -->
<Configuration>
  <Format>cobertura</Format>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*ECommerce\.(Api|Core|Infrastructure)\.dll$</ModulePath>
      </Include>
    </ModulePaths>
    <Sources>
      <Exclude>
        <Source>.*[\\/]obj[\\/].*</Source>
        <Source>.*[\\/]Migrations[\\/].*</Source>
      </Exclude>
    </Sources>
  </CodeCoverage>
</Configuration>
