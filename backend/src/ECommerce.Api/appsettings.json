{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=ecommerce;Username=postgres;Password=postgres"
  },
  "Database": {
    "Provider": "Postgres",
    "MigrateOnStartup": true,
    "SeedDemoData": true
  },
  "Jwt": {
    "Issuer": "shopsense-api",
    "Audience": "shopsense-web",
    "SigningKey": "",
    "AccessTokenMinutes": 60
  },
  "AI": {
    "Anthropic": {
      "ApiKey": "",
      "Model": "claude-opus-5-5",
      "AssistantEffort": "low",
      "CopywriterEffort": "medium",
      "MaxTokens": 8000,
      "MaxToolIterations": 6,
      "EnableRefusalFallbacks": true
    }
  },
  "RateLimiting": {
    "AiRequestsPerMinute": 10,
    "AuthRequestsPerMinute": 10,
    "GlobalBurst": 200,
    "GlobalPerSecond": 50
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Api": {
    "EnableDocs": false
  }
}
